<launch>
  <!-- panorama node -->
  <node name="Panorama" pkg="panorama" type="Panorama" output="screen" args="--v 0">

    <!-- Topics -->
    <param name="events_topic" value="/dvs/events" />
    <param name="camera_info_topic" value="/dvs/camera_info" />
    <param name="trigger_topic" value="/dvs/ext_trigger" />
    
    <!-- COMMON PARAMS -->
    <param name="contrast_measure" value="0" /> 
    <param name="frontend_event_sample_rate" value="2" /> 
    <param name="panorama_height" value="480" /> 
    <param name="panorama_width" value="3163" /> 
    <param name="Focus" value="3900" /> 
    <param name="pixel_size" value="9" /> 

    <param name="engine_file_path" value="/home/orin/workspace/Dataset_Toolbox/src/panorama/model/yolox_grayscale_v2_2_ARM.engine" />
    <param name="conf_thresh" value="0.9" />
    <param name="nms_thresh" value="0.45" />
    <param name="enable_rotation" value="true" />

    <rosparam param="R_matrix">[1.         , 0.         , 0.        ,
                                0.         ,-0.81915204 , 0.57357644,
                                0.          ,-0.57357644 , -0.81915204]</rosparam>

    <!-- <rosparam param="R_matrix">[ 1.        ,  0.         , 0.        ,
                                 0.        , -0.85055509 , 0.52588595,
                                 0.        , -0.52588595 ,-0.85055509]</rosparam> -->


                                


  </node>

  <!-- Publish camera calibration -->

  <node name="dvs_cam_info_pub" pkg="panorama" type="publish_camera_info.py" output="screen"/>  

  <!-- Play rosbag -->
  <!-- <node pkg="rosbag" type="play" name="player" args="-d 1.0 -l -r 1.0 /home/orin/2025-05-10-17-21-31.bag" /> -->

  <!-- Record rosbag -->
  <node pkg="rosbag" type="record" name="recorder" args="/count_image" />
  <!-- Start rviz visualization with preset config -->
  	<node name="rviz" pkg="rviz" type="rviz" args="-d $(find panorama)/config/count_pano.rviz" output="screen">
  </node>

</launch>
