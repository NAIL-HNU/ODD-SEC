<launch>
  <arg name="bag_path" />
  <arg name="output_dir" default="." />

  <node name="Panorama" pkg="panorama" type="Panorama" output="screen" args="--v 0">
    <param name="events_topic" value="/dvs/events" />
    <param name="camera_info_topic" value="/dvs/camera_info" />
    <param name="trigger_topic" value="/dvs/ext_trigger" />
    
    <param name="contrast_measure" value="0" /> 
    <param name="frontend_event_sample_rate" value="4" /> 
    <param name="panorama_height" value="480" /> 
    <param name="panorama_width" value="3163" /> 
    <param name="Focus" value="3900" /> 
    <param name="pixel_size" value="9" /> 
    <param name="x_patches" value="8" /> 
    <param name="y_patches" value="6" /> 
    <param name="decay_sec" value="0.03" /> 
    <param name="gyro_bias_x" value="-7.4367327470491306e-03" /> 
    <param name="gyro_bias_y" value="-6.0057562642741738e-03" /> 
    <param name="gyro_bias_z" value="-4.7496780412127201e-03" /> 
    
    <param name="engine_file_path" value="$(find panorama)/model/yolox_grayscale_v2_2_x86.engine" />
    <param name="conf_thresh" value="0.5" />
    <param name="nms_thresh" value="0.45" />
    
    <param name="threshold" value="10" />

    <rosparam param="R_matrix">[1.0, 0.0, 0.0,
                                0.0, -0.81915204, 0.57357644,
                                0.0, -0.57357644, -0.81915204]</rosparam>

    <param name="bag_file" value="$(arg bag_path)" />
    <param name="output_dir" value="$(arg output_dir)" />
  </node>

  <node name="dvs_cam_info_pub" pkg="panorama" type="publish_camera_info.py" output="screen"/>  

  <node pkg="rosbag" type="play" name="player" args="-d 1.0 -r 1.0 $(arg bag_path)" />

  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find panorama)/config/count_pano.rviz" output="screen" />
</launch>
