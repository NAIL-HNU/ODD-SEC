<launch>
  <node name="photogate_reader" pkg="photogate_reader" type="photogate_reader_node" output="screen">
    <param name="port" type="string" value="/dev/ttyUSB0" />
    <param name="baudrate" type="int" value="9600" />
    <param name="filter_window" type="int" value="5" />
    <param name="high_threshold" type="double" value="0.7" />
  </node>
</launch>