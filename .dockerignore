# Version-control metadata
.git
.gitignore

# Catkin and CMake build products
build/
devel/
install/
log/
**/build/
**/devel/
**/install/
**/.catkin_tools/

# Runtime data and platform-specific TensorRT engines are not needed by the
# platform-independent core image.
data/
**/*.bag
**/*.dat
**/*.engine
**/*.npy

# Local reports, documentation, and editor state
analysis_report.txt
*.md
README*
.agents/
.codex/
.idea/
.vscode/
*.swp
*.swo

# Logs and temporary files
*.log
*.tmp
*.temp

# Operating-system metadata
.DS_Store
Thumbs.db
